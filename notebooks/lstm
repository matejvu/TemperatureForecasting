def forecast_24h_batched(model, X, n_steps=1000):
    
    model.eval()
    seq = X.clone()
    all_preds = []
    with torch.no_grad():
        for _ in range(n_steps):
            out = model(seq)                 # (N, lookback, 1)
            next_val = out[:, -1:, :]        # (N, 1, 1) -- next-step prediction
            all_preds.append(next_val)
            seq = torch.cat([seq[:, 1:, :], next_val], dim=1)  # roll window forward
    return torch.cat(all_preds, dim=1).squeeze(-1).numpy()     # (N, n_steps)


def build_24h_plot(X, start_index, lookback, n_steps, timeseries_len, scaler):
 
    preds_scaled = forecast_24h_batched(model, X, n_steps=n_steps)   # (N, n_steps)
    last_step_scaled = preds_scaled[:, -1].reshape(-1, 1)            # 24th hour only
    last_step = scaler.inverse_transform(last_step_scaled).flatten()

    plot_arr = np.full(timeseries_len, np.nan, dtype='float32')
    for i in range(X.shape[0]):
        idx = start_index + i + lookback - 1 + n_steps
        if idx < timeseries_len:
            plot_arr[idx] = last_step[i]
    return plot_arr


