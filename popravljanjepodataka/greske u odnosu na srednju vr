import pandas as pd
from sklearn.metrics import mean_squared_error
import os
import numpy as np


df=pd.read_csv("/home/polaznik/Desktop/nevena/TemperatureForecasting/real_data/berlin_data.csv")
print(df.head())

df = df.iloc[600:]

df = df.reset_index(drop=True)



srednjatemp = df["temperature_2m"].mean()
print("srednja temp", srednjatemp)

#relativna

def relativna(temperature_2m, srednjatemp):
    y_true = df[temperature_2m]

    y_true_masked = y_true.replace(0, np.nan)

    relative_errors = np.abs(
        (srednjatemp-y_true_masked) / y_true_masked)

    mre = np.nanmean(relative_errors)

    return mre


mre = relativna(
    "temperature_2m",
    srednjatemp)

print("relativna", mre)

#kvadratna


y_pred = df['temperature_2m']
y_true = np.full(len(y_pred), srednjatemp)

mse = mean_squared_error(y_true, y_pred)

print("srednja kvadratna", mse)

